        <line choice="default">
            <line choice="io.github.realazk.ootrr"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="io.github.realazk.ootrr" visible="false">
        <pkg-ref id="io.github.realazk.ootrr"/>
    </choice>
    <pkg-ref id="io.github.realazk.ootrr" version="@VERSION@" onConclusion="none">ootrr-component.pkg</pkg-ref>
</installer-gui-script>
